:root {
  --bg-top: #84d3ff;
  --bg-bottom: #dff5ff;
  --panel: rgba(15, 23, 42, 0.78);
  --panel-border: rgba(148, 163, 184, 0.28);
  --text: #edf4ff;
  --muted: #dfe7f5;
  --button: rgba(30, 41, 59, 0.9);
  --button-selected: #3b82f6;
  --shadow: rgba(15, 23, 42, 0.35);
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: linear-gradient(var(--bg-top), var(--bg-bottom));
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px;
}

.topbar {
  width: min(960px, 94vw);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  padding: 12px 18px;
  box-shadow: 0 8px 20px var(--shadow);
}

.brand {
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.stats {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  font-weight: 700;
  color: var(--muted);
}

#gameCanvas {
  width: min(960px, 94vw);
  height: auto;
  display: block;
  border-radius: 12px;
  border: 1px solid var(--panel-border);
  box-shadow: 0 12px 24px var(--shadow);
  background: linear-gradient(#7cc7ff, #dff5ff);
  image-rendering: pixelated;
}

#hotbar {
  width: min(960px, 94vw);
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  padding: 10px;
  box-shadow: 0 10px 22px var(--shadow);
}

.hotbar-slot {
  border: 2px solid rgba(148, 163, 184, 0.5);
  border-radius: 10px;
  background: var(--button);
  min-width: 118px;
  padding: 8px 10px;
  color: var(--text);
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  cursor: pointer;
  transition: transform 0.12s ease, border-color 0.12s ease;
}

.hotbar-slot:hover {
  transform: translateY(-1px);
}

.hotbar-slot.selected {
  border-color: var(--button-selected);
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.4);
  background: rgba(30, 64, 175, 0.7);
}

.hotbar-name {
  font-size: 0.82rem;
}

.hotbar-count {
  font-size: 0.74rem;
  color: var(--muted);
}

.controls {
  width: min(960px, 94vw);
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16px;
  background: rgba(15, 23, 42, 0.78);
  border: 1px solid var(--panel-border);
  border-radius: 12px;
  padding: 10px 16px;
  color: var(--muted);
  font-size: 0.92rem;
}

@media (max-width: 700px) {
  .topbar {
    flex-direction: column;
    gap: 8px;
  }

  .stats {
    justify-content: center;
  }
}
